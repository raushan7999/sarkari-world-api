PROJECT_NAME="Sarkari World API"
VERSION="0.1.0"
ENVIRONMENT="local"
DEBUG=false
# The deployed host is api.sarkariworld.com, so the path does not repeat the
# word: routes are /v1/..., not /api/v1/.... Health stays at the server root.
API_V1_PREFIX="/v1"
# Optional. Mounts the same routes a second time on an older prefix so cached
# browser bundles keep working through a cutover. Hidden from the OpenAPI
# document. Leave unset unless you are mid-migration.
# LEGACY_API_PREFIX="/api/v1"

# CORS. Public read routes use CORS_ORIGINS; the authenticated and admin
# surface accepts the union of both lists. The same list arms the CSRF check,
# so the website origin MUST be listed here or browser sign-in and bookmarks
# fail: the browser blocks the cross-origin call before it reaches a route.
# The website's own server-side fetches are unaffected (no browser, no CORS).
# e.g. CORS_ORIGINS='["http://localhost:3000","https://sarkariworld.com"]'
CORS_ORIGINS='[]'
ADMIN_CORS_ORIGINS='[]'

# Auth. SESSION_SECRET must be >=32 characters in production or boot fails;
# development mints an ephemeral key.
SESSION_SECRET=""
COOKIE_DOMAIN=""
BEHIND_TLS_PROXY=false
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_HD=""

# Logging. LOG_JSON=false gives coloured console output for local dev.
LOG_LEVEL="INFO"
LOG_JSON=true

# PostgreSQL. Points at the same database the Node service uses.
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/sarkariworld"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_ECHO=false
# Stored timestamps are naive and IST-relative; changing this shifts them.
DB_TIMEZONE="Asia/Kolkata"

# Advertised as the server URL in the OpenAPI document
BASE_URL="http://127.0.0.1:8000"

# Interactive docs. ENABLE_DOCS=false also disables /openapi.json and /docs.
ENABLE_DOCS=true
