PROJECT_NAME="Sarkari World API"
VERSION="0.1.0"
ENVIRONMENT="local"
DEBUG=false
API_V1_PREFIX="/api/v1"

# Comma-separated list, e.g. '["http://localhost:3000"]'
CORS_ORIGINS='[]'

# Logging — LOG_JSON=false gives coloured console output for local dev
LOG_LEVEL="INFO"
LOG_JSON=true

# PostgreSQL
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/sarkari_world"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Auth (placeholder)
ADMIN_TOKEN=""
